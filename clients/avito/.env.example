# Клиент Авито — переменные окружения

# URL сервера-аккумулятора
SERVER_URL=http://localhost:8000

# Идентификатор клиента (не менять!)
CLIENT_ID=avito

# Avito: путь к cookies.json (Firefox export)
AVITO_COOKIES_FILE=cookies.json

# Avito: строка Cookie целиком (приоритетнее cookies.json при мердже)
AVITO_COOKIE=

# Avito: URL поиска для онлайн-парсинга
AVITO_SEARCH_URL=

# Avito: максимальное число страниц (0 — без лимита)
AVITO_MAX_PAGES=5

# Avito: прокси (http://user:pass@host:port)
AVITO_PROXY=

# Уровень логирования: trace / debug / info / warn / error
LOG_LEVEL=info