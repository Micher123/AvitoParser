# Клиент Циан — переменные окружения

# URL сервера-аккумулятора
SERVER_URL=http://localhost:8000

# Идентификатор клиента (не менять!)
CLIENT_ID=cian

# Циан: Cookie для API авторизации
CIAN_SEARCH_COOKIE=

# Циан: URL поиска
CIAN_SEARCH_URL=

# Циан: максимальное число страниц (0 — без лимита)
CIAN_MAX_PAGES=5

# Циан: прокси (http://user:pass@host:port)
CIAN_PROXY=

# Уровень логирования: trace / debug / info / warn / error
LOG_LEVEL=info